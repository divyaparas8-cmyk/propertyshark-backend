# Root Git Ignore for Property Intelligence Project (Frontend + Backend)

# Dependencies across all subfolders
node_modules/
**/node_modules/

# Environment Variables & Secrets (Keep .env files hidden, track .env.example)
.env
.env.local
.env.*.local
**/.env
!**/.env.example

# Build & Dist Outputs
dist/
dist-ssr/
**/dist/

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
.system_generated/

# OS & Editor files
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?


backend
/backend
